# Copy to .env (git-ignored). Never commit real values. Full key list: docs/integration-keys.md
ISSUER_MOCK=1                     # 0 = real Reclaim verification
ISSUER_PRIVATE_KEY=               # 0x + 64 hex; its address must be BusinessPassRegistry.issuer
ISSUER_PEPPER=                    # openssl rand -hex 32, prefix 0x. NEVER rotate.
CHAIN_ID=31337                    # 11155111 on Sepolia
REGISTRY_ADDRESS=                 # BusinessPassRegistry
CORS_ALLOW_ORIGINS=http://localhost:3000   # apps/web + portal origins, comma-separated (CORS_ORIGINS also read)

# ---- Real mode (ISSUER_MOCK=0) ----
RECLAIM_APP_ID=                   # dev.reclaimprotocol.org -> your application -> Application ID (public, 0x...)
RECLAIM_APP_SECRET=               # same page, shown once at creation (SECRET). Used to init sessions server-side.
RECLAIM_PROVIDER_ID=              # the issuer-only custom provider (RECLAIM_PROVIDER.md)
# RECLAIM_PROVIDER_ID_BAND1= / _BAND2= / _BAND3=   # one provider per band (they differ in band_ge_k only)
# RECLAIM_PROVIDER_VERSION=       # exact version to pin; unset = the version Reclaim resolves for the session
# RECLAIM_PROVIDER_HASHES=        # offline pin instead of the provider id (verify only; sessions still need the id)
RECLAIM_EXPECTED_URL=             # https://<portal-host>/api/me/summary
ISSUER_PUBLIC_URL=                # https://<issuer-host>: Reclaim POSTs proofs here. Unset = issuer polls Reclaim.
# RECLAIM_VERIFICATION_MODE=portal   # portal (remote browser, default) | app (Reclaim Verifier app / App Clip)
# RECLAIM_SESSION_TTL_SEC=900
# RECLAIM_REQUIRE_TEE=0
ISSUER_REQUIRE_LEAF_CHECK=1       # default on: app must send h + country; leaf is recomputed
# TRUST_PROXY=1                   # behind a reverse proxy
