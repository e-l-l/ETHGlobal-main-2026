{
  "name": "@repo/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Merchant Revenue Advance: framework-agnostic SDK. One config value switches every screen from mock data to the local devnet or Sepolia.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "default": "./dist/mock/index.js"
    },
    "./browser/anon": {
      "types": "./dist/browser/anon.d.ts",
      "default": "./dist/browser/anon.js"
    },
    "./browser/prover": {
      "types": "./dist/browser/prover.d.ts",
      "default": "./dist/browser/prover.js"
    },
    "./browser/prover-core": {
      "types": "./dist/browser/prover-core.d.ts",
      "default": "./dist/browser/prover-core.js"
    },
    "./browser/prover.worker": {
      "types": "./dist/browser/prover.worker.d.ts",
      "default": "./dist/browser/prover.worker.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "node scripts/openapi.mjs",
    "sync-backend": "node scripts/sync-backend.mjs",
    "test:prover": "MRA_PROVER_E2E=1 vitest run test/browser-prover.test.ts",
    "sync-circuits": "node scripts/sync-circuits.mjs"
  },
  "dependencies": {
    "@anon-rpc/browser-harness": "0.4.0",
    "@aztec-foundation/bb.js": "6.0.0",
    "@noir-lang/noir_js": "1.0.0-rc.3",
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
