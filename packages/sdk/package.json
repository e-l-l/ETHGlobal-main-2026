{
  "name": "@repo/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Merchant Revenue Advance: framework-agnostic SDK. One config value switches every screen from mock data to the local devnet or Sepolia.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "default": "./dist/mock/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check-types": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "openapi": "node scripts/openapi.mjs",
    "sync-backend": "node scripts/sync-backend.mjs"
  },
  "dependencies": {
    "viem": "^2.57.16"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "^5.1.0"
  }
}
