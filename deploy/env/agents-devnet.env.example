# deploy/env/agents-devnet.env: runtime env for agents-api-devnet (and `deploy/devnet.sh scene --llm`).
# Copy to agents-devnet.env (git-ignored). deploy.sh creates it automatically from this template when DEVNET=1:
# it fills the three random values below and copies ONLY the LLM settings from agents.env (never the Sepolia keys).
#
# THE KEYS BELOW ARE ANVIL'S PUBLIC TEST KEYS ("test test ... junk" mnemonic). Everyone knows them. They are
# correct for the public devnet (chain 31337, DeployLocal.s.sol wires these exact addresses as offer signer, risk
# manager, Business Pass issuer and AgentPass attester) and worthless anywhere else. NEVER put a Sepolia or
# mainnet key in this file: deploy.sh refuses to start if any key here equals one in agents.env.
# RPC_URL, CHAIN_ID, DB_PATH and DEPLOYMENTS_FILE are set by docker-compose.yml; do not add them here.
# No inline comments after values: docker compose would keep them as part of the value.

# anvil account 1
OFFER_SIGNER_PRIVATE_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# anvil account 2
RISK_MANAGER_PRIVATE_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
# anvil account 3
RELAYER_PRIVATE_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6
# anvil account 4 (devnet Business Pass issuer)
ISSUER_PRIVATE_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a
# anvil account 5 (devnet AgentPass attester)
ATTESTER_PRIVATE_KEY=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba

# Random per box (deploy.sh fills these: `openssl rand -hex 32`). Not shared with Sepolia.
PAYER_HASH_KEY=
BUSINESS_PEPPER=
AGENT_KEY_ENCRYPTION_KEY=

# World Agent Pass / IDKit stay mocked on the devnet.
WORLD_MOCK=1

# --- LLM (deploy.sh copies these from agents.env if present) ---
LLM_PROVIDER=
# ANTHROPIC_API_KEY=
# BEDROCK_API_KEY=
# BEDROCK_REGION=
# BEDROCK_UNDERWRITER_MODEL=
# BEDROCK_CRITIC_MODEL=
# BEDROCK_RISK_MODEL=
# ANTHROPIC_MODEL=
