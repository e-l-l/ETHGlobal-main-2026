# deploy/env/demo-portal.env: demo seller portal runtime env. Copy to demo-portal.env (git-ignored).
# NEVER commit real values. No inline comments after values: docker compose would keep them as part of the value.

# --- Required --- 32+ random chars: `openssl rand -base64 48`. Without it /api/health returns 503.
SESSION_SECRET=

# --- Optional (see demo/portal/README.md) ---
# DEMO_EXTRA_ACCOUNTS_JSON=
# LOGIN_RATE_LIMIT_MAX=        # [10]
# LOGIN_RATE_LIMIT_WINDOW_SEC= # [300]
