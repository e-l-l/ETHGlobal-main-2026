# deploy/env/agents.env: runtime env for agents-api AND agents-worker. Copy to agents.env (git-ignored).
# NEVER commit real values. No inline comments after values: docker compose would keep them as part of the value. Fill the required keys locally with the clipboard helper (see secrets-howto.md).
# Keys with an empty value are passed as EMPTY STRINGS (not "unset"), so optional keys stay commented out
# until you need them. DB_PATH and DEPLOYMENTS_FILE are set by docker-compose.yml; do not add them here.

# --- Required ---
# Sepolia JSON-RPC (Anon-RPC endpoint or provider URL); NOT the anvil URL
RPC_URL=
# 11155111 for Sepolia
CHAIN_ID=
# anthropic | bedrock | bedrock-converse
LLM_PROVIDER=
# signs offers only; holds no funds
OFFER_SIGNER_PRIVATE_KEY=
# calls lowerLimits; small Sepolia ETH float
RISK_MANAGER_PRIVATE_KEY=
# submits draws/claims/keeper txs; small Sepolia ETH float
RELAYER_PRIVATE_KEY=
# HMAC key, e.g. `openssl rand -hex 32`
PAYER_HASH_KEY=

# --- LLM credentials (one of these, matching LLM_PROVIDER) ---
# ANTHROPIC_API_KEY=
# BEDROCK_API_KEY=

# --- Optional (defaults shown in brackets) ---
# BEDROCK_REGION=            # [ap-south-1]
# BEDROCK_UNDERWRITER_MODEL= # [mistral.mistral-large-3-675b-instruct]
# BEDROCK_CRITIC_MODEL=      # [moonshotai.kimi-k2.5]
# BEDROCK_RISK_MODEL=        # [qwen.qwen3-235b-a22b-2507-v1:0]
# ANTHROPIC_MODEL=           # [claude-opus-5-5]
# UNDERWRITER_EFFORT=        # [medium]
# CRITIC_EFFORT=             # [high]
# RISK_EFFORT=               # [low]
# MAX_DAYS_TO_REPAY=         # [60]
# OFFER_TTL_SECONDS=         # [900]
# RISK_LOOP_SECONDS=         # [300]  worker: Risk agent cadence
# KEEPER_LOOP_SECONDS=       # [60]   worker (fallback loop): keeper cadence
