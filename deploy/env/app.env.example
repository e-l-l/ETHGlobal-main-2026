# deploy/env/app.env: merchant app SERVER-side runtime env. Copy to app.env (git-ignored).
# NEVER commit real values. No inline comments after values: docker compose would keep them as part of the value. Public NEXT_PUBLIC_* build values live in compose.env, not here.
# API_URL, APP_ORIGIN and DEPLOYMENTS_PATH are set by docker-compose.yml; do not add them here.
# Optional keys stay commented out: an empty value is passed as an empty string.

# --- Required for the real (non-mock) flows ---
# `openssl rand -base64 48`
RECOVERY_PEPPER=
# server-side Sepolia RPC (used by /api/demo/pay)
RPC_URL=

# --- Optional, per integration ---
# DEMO_CUSTOMER_PK=          # demo payer key for /api/demo/pay (testnet only, tiny balance)
# RECLAIM_PROVIDER_ID=
# RP_SIGNING_KEY=            # World ID RP signing key
# WORLD_ENVIRONMENT=         # staging | production
# WORLD_OIDC_CLIENT_ID=
# WORLD_OIDC_CLIENT_SECRET=
# WORLD_OIDC_ISSUER=
