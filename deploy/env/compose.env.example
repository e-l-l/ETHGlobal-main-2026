# deploy/env/compose.env: values docker compose interpolates into docker-compose.yml.
# Copy to compose.env (git-ignored). NOTHING SECRET goes here: NEXT_PUBLIC_* values end up in the
# browser bundle, so every value in this file is public.

# Hostname suffix. Leave empty on EC2: deploy.sh derives <ip-dashed>.sslip.io from the instance's public IP.
# Real domain later: HOST_SUFFIX=demo.example.com (needs DNS A records for app/api/portal/issuer.<suffix>).
HOST_SUFFIX=

# Which agents/deployments/<name>.json the agents and app read (default: sepolia).
DEPLOYMENTS_NAME=

# Public devnet (anvil) for the default scene: 1 = start anvil, the deployer, rpc-proxy and agents-api-devnet,
# served at https://rpc.<HOST_SUFFIX> and https://api-devnet.<HOST_SUFFIX>. Empty/0 = off. See deploy/README.md.
DEVNET=
# Public RPC limits per client IP (defaults: 15 calls/s, burst 60, 30 raw txs/min, 256 KiB bodies, 50-call batches)
DEVNET_RPC_RATE_PER_SEC=
DEVNET_RPC_RATE_BURST=
DEVNET_RPC_SEND_PER_MIN=
DEVNET_RPC_MAX_BODY_BYTES=
DEVNET_RPC_MAX_BATCH=

# Issuer container port and health path (defaults: 4000 and /health). Match issuer/'s server.
ISSUER_PORT=
ISSUER_HEALTH_PATH=

# --- Merchant app build-time values (inlined at `next build`; rebuild the app after changing). ---
# Every integration defaults to "mock" when empty, so an empty value is always demo-safe.
# mock | real
NEXT_PUBLIC_API_MODE=
# mock | anon | plain
NEXT_PUBLIC_RPC_MODE=
# mock | real
NEXT_PUBLIC_RECLAIM_MODE=
# mock | real
NEXT_PUBLIC_WORLD_MODE=
# mock | real
NEXT_PUBLIC_AGENT_PASS_MODE=
# mock | real
NEXT_PUBLIC_PROVER_MODE=
# empty = https://api.<HOST_SUFFIX>
NEXT_PUBLIC_API_URL=
# public Sepolia RPC for browser reads, e.g. a publicnode/Alchemy URL
NEXT_PUBLIC_RPC_URL=
# 11155111 for Sepolia (empty = 31337)
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_ANON_RPC_SPECIFIER=
NEXT_PUBLIC_ANON_RPC_BOOTSTRAP_URL=
NEXT_PUBLIC_ANON_RPC_CONFIG=
# BusinessPassRegistry address
NEXT_PUBLIC_BUSINESS_REGISTRY=
# AR | NG | KE
NEXT_PUBLIC_BIZ_COUNTRY=
# 1 | 2 | 3
NEXT_PUBLIC_BIZ_REVENUE_BAND=
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ACTION=
NEXT_PUBLIC_WORLD_RP_ID=
# managed agent's PUBLIC address
NEXT_PUBLIC_AGENT_KEY=
NEXT_PUBLIC_DEMO_SHOP_LABEL=
