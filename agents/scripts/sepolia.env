# Sepolia network profile (no secrets; keys come from agents/.env).
#   set -a; . ./.env; . scripts/sepolia.env; set +a
# Tenderly's gateway is consistent; publicnode's load balancer returned "block not found" mid-script.
RPC_URL=https://sepolia.gateway.tenderly.co
CHAIN_ID=11155111
DEPLOYMENTS_FILE=deployments/sepolia.json
DB_PATH=data/sepolia.sqlite
