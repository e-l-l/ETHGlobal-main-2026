# Copy to .env (git-ignored). Never commit real values.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# LLM backend: anthropic | bedrock (Claude on Bedrock) | bedrock-converse (other Bedrock models)
LLM_PROVIDER=bedrock-converse
ANTHROPIC_API_KEY=
BEDROCK_API_KEY=            # use scripts/secret_from_clipboard.py BEDROCK_API_KEY
BEDROCK_REGION=ap-south-1
BEDROCK_UNDERWRITER_MODEL=mistral.mistral-large-3-675b-instruct
BEDROCK_CRITIC_MODEL=moonshotai.kimi-k2.5
BEDROCK_RISK_MODEL=qwen.qwen3-235b-a22b-2507-v1:0
OFFER_SIGNER_PRIVATE_KEY=
RISK_MANAGER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
PAYER_HASH_KEY=

# ---- Managed agents + World (docs/integration-keys.md) ----
ATTESTER_PRIVATE_KEY=
AGENT_KEY_ENCRYPTION_KEY=
CORS_ALLOW_ORIGINS=
WORLD_MOCK=1
# Agent Pass: World ID OIDC client ("World IdP"). Aliases WORLD_OIDC_CLIENT_ID / _SECRET / _ISSUER also work.
WORLD_AGENT_PASS_CLIENT_ID=
WORLD_AGENT_PASS_CLIENT_SECRET=
# WORLD_AGENT_PASS_ISSUER=https://auth.world.org
# WORLD_AGENT_PASS_REDIRECT_URI=https://<app-host>/agent-pass/callback
# WORLD_AGENT_PASS_CLIENT_AUTH=client_secret_post
# WORLD_AGENT_PASS_ACR=
# IDKit 4 credential recovery
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_RP_SIGNING_KEY=
# WORLD_ENVIRONMENT=production
# WORLD_RECOVERY_ACTION=credential-recovery-v1
