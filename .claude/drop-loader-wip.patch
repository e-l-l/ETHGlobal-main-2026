+/* ------------------------------------------------------------- DropLoader */
+
+/**
+ * The brand loader: the drop with its bands filling in turn (JarMark `loading`), plus a caption.
+ * `block` fills the content area for a screen that is waiting; `inline` sits in a card or list row.
+ * Use this for every loading state; `Spinner` is only for inside buttons.
+ */
+export function DropLoader({
+  caption,
+  hint,
+  variant = "block",
+  on = "light",
+  className,
+}: {
+  caption: ReactNode;
+  /** A quieter second line under a block caption, e.g. how long it can take. */
+  hint?: ReactNode;
+  variant?: "block" | "inline";
+  on?: "light" | "dark";
+  className?: string;
+}) {
+  const tone = on === "dark" ? "text-honeydew" : "text-charcoal-muted";
+  if (variant === "inline") {
+    return (
+      <div role="status" className={cn("flex items-center gap-2.5 font-body text-note", tone, className)}>
+        <JarMark size={24} loading on={on} />
+        <span>{caption}</span>
+      </div>
+    );
+  }
+  return (
+    <div role="status" className={cn("flex min-h-[50vh] flex-col items-center justify-center gap-4 px-6 py-12 text-center", className)}>
+      <JarMark size={56} loading on={on} />
+      <div className="flex max-w-xs flex-col gap-1">
+        <p className={cn("m-0 font-body text-read font-semibold", on === "dark" ? "text-canvas" : "text-charcoal")}>{caption}</p>
+        {hint ? <p className={cn("m-0 font-body text-note", tone)}>{hint}</p> : null}
+      </div>
+    </div>
+  );
+}
