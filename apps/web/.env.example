# apps/web → @repo/sdk. Copy to .env.local and edit. Every value is read in src/lib/mra.ts (the one place the
# SDK client is built). NEXT_PUBLIC_* values are inlined at build time, so rebuild / restart `next dev` after a change.
# No secrets belong here: everything below ends up in the browser bundle.

# Which backend every screen uses: mock | local | sepolia. Default: mock (the built-in demo data, no network).
#   mock     the UI looks exactly as it always has; data renders on the server
#   local    anvil :8545 + agents API :8000 + issuer :8787 (URLs below are optional, these are the defaults)
#   sepolia  needs NEXT_PUBLIC_API_URL and NEXT_PUBLIC_ISSUER_URL
NEXT_PUBLIC_MRA_MODE=mock

# Agents FastAPI (merchant agent, risk, relay, recovery). Local default http://localhost:8000. Required for sepolia.
# The API must allow this origin: CORS_ALLOW_ORIGINS=http://localhost:3001
NEXT_PUBLIC_API_URL=

# Business Pass issuer (onboarding). Local default http://localhost:8787. Required for sepolia onboarding.
NEXT_PUBLIC_ISSUER_URL=

# Contract addresses as one line of JSON (the contents of agents/deployments/<net>.json), instead of the SDK's
# bundled copy. Needed for a FRESH local devnet: its addresses differ from packages/sdk/src/deployments/local.json.
#   NEXT_PUBLIC_MRA_DEPLOYMENT=$(jq -c . agents/deployments/local.json)      (docs/LOCAL.md does this for you)
# Empty = bundled addresses. Ignored in mock.
NEXT_PUBLIC_MRA_DEPLOYMENT=

# JSON-RPC for chain reads. Defaults: local http://127.0.0.1:8545, sepolia https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_RPC_URL=

# Route chain reads through Anon-RPC (@repo/sdk/browser/anon), 1 / 0. Ignored in mock.
# Default when unset: on for sepolia, off for local (the anon network's exits can't reach anvil on your laptop).
# If Anon-RPC is unavailable, reads go direct unless NEXT_PUBLIC_ANON_RPC_STRICT=1 (fail closed: nothing is sent).
NEXT_PUBLIC_ANON_RPC=
NEXT_PUBLIC_ANON_RPC_STRICT=0
# Anon-RPC network: nox (specifier on Sepolia, default) | tor-js | nym | passthrough (wiring tests only, not anonymous)
NEXT_PUBLIC_ANON_NETWORK=nox

# Read-only lender account for L01–L03 (and the wallet chip) when no wallet is connected. Optional.
NEXT_PUBLIC_LENDER_ACCOUNT=

# Mock mode only: simulated latency per SDK call in ms, so spinners show. Default 0.
NEXT_PUBLIC_MRA_MOCK_LATENCY_MS=0

# Build: force the stand-ins for @repo/sdk/browser/{anon,prover} (1), e.g. if the real modules break a build.
# Without it, next.config.ts uses the real modules whenever the SDK ships them, and the stand-ins otherwise.
NEXT_PUBLIC_MRA_BROWSER_STUBS=0

# Per-call timeout for chain/API reads in live modes (default 90000 with Anon-RPC, 45000 without).
# NEXT_PUBLIC_MRA_TIMEOUT_MS=90000
